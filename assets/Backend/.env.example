# ============================================
# A1 FITNESS - CLEAN AUTH BACKEND ENV TEMPLATE
# ============================================
# Copy this file to `.env` and fill in real values before running.

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (used by web/admin clients).
# The React Native app does not send an Origin header, so it is unaffected.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

# MongoDB connection string (replace with your deployment value)
MONGO_URI=mongodb://127.0.0.1:27017/gymza

# JWT Secrets - generate long random values (openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# Token lifetimes (jsonwebtoken expiresIn format)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d